# /etc/systemd/system/acars-dev07.service

[Unit]
Description=acars-dev07
After=multi-user.target

[Service]
User=root
ExecStart=/home/wombat/github/mellow-capybara-v1/bin/acars-dev07.sh
StandardOutput=null
Restart=no

# No [Install] section — acars-dev07 is not auto-started at boot.
# It is started on-demand by bootboy.py via 'systemctl start acars-dev07.service'.
