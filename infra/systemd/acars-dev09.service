# /etc/systemd/system/acars-dev09.service

[Unit]
Description=acars-dev09
After=multi-user.target

[Service]
User=root
ExecStart=/home/wombat/github/mellow-capybara-v1/bin/acars-dev09.sh
StandardOutput=null
Restart=no

# No [Install] section — acars-dev09 is not auto-started at boot.
# It is started on-demand by bootboy.py via 'systemctl start acars-dev09.service'.
