# /etc/systemd/system/acars-dev10.service

[Unit]
Description=acars-dev10
After=multi-user.target

[Service]
User=root
ExecStart=/home/wombat/github/mellow-capybara-v1/bin/acars-dev10.sh
StandardOutput=null
Restart=no

# No [Install] section — acars-dev10 is not auto-started at boot.
# It is started on-demand by bootboy.py via 'systemctl start acars-dev10.service'.
