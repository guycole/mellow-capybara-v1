# /etc/systemd/system/acars-dev04.service

[Unit]
Description=acars-dev04
After=multi-user.target

[Service]
User=root
ExecStart=/home/wombat/github/mellow-capybara-v1/bin/acars-dev04.sh
StandardOutput=null
Restart=no

# No [Install] section — acars-dev04 is not auto-started at boot.
# It is started on-demand by bootboy.py via 'systemctl start acars-dev04.service'.
