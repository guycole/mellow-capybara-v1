# /etc/systemd/system/acars-dev03.service

[Unit]
Description=acars-dev03
After=multi-user.target

[Service]
User=root
ExecStart=/home/wombat/github/mellow-capybara-v1/bin/acars-dev03.sh
StandardOutput=null
Restart=no

# No [Install] section — acars-dev03 is not auto-started at boot.
# It is started on-demand by bootboy.py via 'systemctl start acars-dev03.service'.
